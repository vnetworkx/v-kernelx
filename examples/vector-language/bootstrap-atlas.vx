// ATLAS Development/Bootstrap Token Definition (3-Dimensional Token Vector [token, authratio(au), energy])
// Only permitted in DEVELOPMENT / TESTNET profiles (or explicitly genesis-authorized PRODUCTION).
// Region: ATLAS (prefix=ATL, title="Atlas Vector Region", visibility="public", section=1)
// Token: ATLAS TOKEN (symbol="ATLAS", purpose="Development/bootstrap", external_monetary_value="None")
space create AtlasCoreSpace {
    name = "Atlas Core Space";
    visibility = "public";
}

region create ATLAS in "AtlasCoreSpace" {
    name = "ATLAS";
    prefix = "ATL";
    title = "Atlas Vector Region";
    visibility = "public";
    section = 1;
}

wallet create AtlasTreasuryWallet in "ATLAS" {
    name = "Atlas Treasury Wallet";
}

wallet create AtlasDistributionWallet in "ATLAS" {
    name = "Atlas Distribution Wallet";
}

token create ATLAS in "AtlasTreasuryWallet" {
    name = "ATLAS TOKEN";
    symbol = "ATLAS";
    dimensions = 3;
    vector = [1000000, 1000, 0];
    max_supply = 1000000;
    drain_bps = 100;
    purpose = "Development/bootstrap";
    external_monetary_value = "None";
}

transfer "ATLAS" from "AtlasTreasuryWallet" to "AtlasDistributionWallet" amount 10000;
verify proof network;
reconstruct "ATLAS";
