# Vector Network Explorer & Node Environment Variables

# --- Explorer UI / Next.js Server Proxy ---
VNETWORK_API_URL=http://127.0.0.1:8080
ATLAS_DATA_DIR=
# Administrative token required by Next.js admin/backup routes and Rust POST /v1/nodes/connect
ATLAS_ADMIN_TOKEN=
NETWORK_ADMIN_TOKEN=

# --- Node & Consensus Network Configuration ---
NETWORK_ID=vector-devnet-1
NETWORK_NAME=Vector Development Network
NETWORK_PROFILE=DEVELOPMENT
NETWORK_PROTOCOL_VERSION=vector-network/1.0.0
NETWORK_NODE_KIND=FULL_NODE
NETWORK_ENABLE_PUBLIC_API=true
NETWORK_ENABLE_P2P=true
NETWORK_ENABLE_VALIDATOR=false
NETWORK_ALLOW_BOOTSTRAP_ATLAS=
NETWORK_ALLOW_LOCAL_P2P=false
NETWORK_BOOTSTRAP_PEERS=
NETWORK_LISTEN_ADDRESSES=
NETWORK_ADVERTISED_ADDRESSES=
NETWORK_DISCOVERY_MODE=hybrid
NETWORK_GENESIS_FILE=
NETWORK_NODE_IDENTITY=
NETWORK_PUBLIC_API=http://127.0.0.1:8080
NETWORK_PUBLIC_API_BIND=127.0.0.1:8080
NETWORK_QUORUM_THRESHOLD_BPS=6667
NETWORK_STORAGE_PATH=
NETWORK_VALIDATOR_ID=
NETWORK_VALIDATOR_KEY_PATH=

# --- API Security, Key Encryption, TLS & Operations ---
NETWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NETWORK_KEY_PASSPHRASE=
NETWORK_KEY_PASSPHRASE_FILE=
NETWORK_DRAIN_POLICY=
NETWORK_TLS_CONFIGURATION=
NETWORK_TRUST_PROXY_HEADERS=false
NETWORK_CONSENSUS_TIMEOUT_MS=8000

# --- Deprecated / Legacy Variables (Unused; retained for audit clarity) ---
# DEPRECATED: Replaced by NETWORK_KEY_PASSPHRASE / NETWORK_KEY_PASSPHRASE_FILE
ATLAS_KEYSTORE_PASSPHRASE=
# DEPRECATED: Requests are authenticated via Ed25519 signatures and NETWORK_ADMIN_TOKEN
ATLAS_SESSION_SECRET=