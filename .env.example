# ==========================================
# ATLAS VECTOR NETWORK
# DEVELOPMENT CONFIGURATION
# ==========================================

# ATLAS APPLICATION
ATLAS_ADMIN_TOKEN=REPLACE_WITH_RANDOM_SECRET
ATLAS_DATA_DIR=./data/atlas
ATLAS_KEYSTORE_PASSPHRASE=REPLACE_WITH_STRONG_UNIQUE_PASSPHRASE
ATLAS_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET

# NETWORK IDENTITY
NETWORK_ID=atlas-devnet
NETWORK_NAME=ATLAS
NETWORK_PROFILE=development
NETWORK_PROTOCOL_VERSION=1.0.0

# NODE CONFIGURATION
NETWORK_NODE_KIND=full
NETWORK_NODE_IDENTITY=./data/identity/node.identity

# PEER-TO-PEER
NETWORK_ENABLE_P2P=true
NETWORK_LISTEN_ADDRESSES=/ip4/0.0.0.0/tcp/7400
NETWORK_ADVERTISED_ADDRESSES=
NETWORK_BOOTSTRAP_PEERS=
NETWORK_DISCOVERY_MODE=static

# DEVELOPMENT BOOTSTRAP
NETWORK_ALLOW_BOOTSTRAP_ATLAS=true
NETWORK_GENESIS_FILE=./config/atlas-devnet-genesis.json

# VALIDATOR
NETWORK_ENABLE_VALIDATOR=false
NETWORK_VALIDATOR_ID=
NETWORK_VALIDATOR_KEY_PATH=

# CONSENSUS
NETWORK_QUORUM_THRESHOLD_BPS=

# PUBLIC API
NETWORK_ENABLE_PUBLIC_API=true
NETWORK_PUBLIC_API=http://127.0.0.1:8080
NETWORK_PUBLIC_API_BIND=127.0.0.1:8080

# STORAGE
NETWORK_STORAGE_PATH=./data/network

# SDK CONNECTION
VNETWORK_API_URL=http://127.0.0.1:8080
