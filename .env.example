# Next.js Explorer Proxy -> live Rust vnetwork-node / vnetwork-api endpoint
VNETWORK_API_URL=http://127.0.0.1:8080

# Authoritative Rust Node Configuration Overrides (consumed by crates/vnetwork-node/src/config.rs)
NETWORK_PROFILE=DEVELOPMENT
NETWORK_ID=vector-devnet-1
NETWORK_NAME=Vector Development Network
NETWORK_PROTOCOL_VERSION=vector-network/1.0.0
NETWORK_NODE_KIND=FULL_NODE
NETWORK_ENABLE_P2P=true
NETWORK_ENABLE_PUBLIC_API=true
NETWORK_ENABLE_VALIDATOR=false
NETWORK_LISTEN_ADDRESSES=/ip4/127.0.0.1/tcp/7001
NETWORK_ADVERTISED_ADDRESSES=
NETWORK_BOOTSTRAP_PEERS=
NETWORK_DISCOVERY_MODE=hybrid
NETWORK_PUBLIC_API_BIND=127.0.0.1:8080
NETWORK_PUBLIC_API=http://127.0.0.1:8080
NETWORK_STORAGE_PATH=./data/node1
NETWORK_NODE_IDENTITY=./data/node1/node.key.json
NETWORK_VALIDATOR_KEY_PATH=
NETWORK_VALIDATOR_ID=
NETWORK_GENESIS_FILE=
NETWORK_QUORUM_THRESHOLD_BPS=6667
NETWORK_ALLOW_BOOTSTRAP_ATLAS=true
# NETWORK_TLS_CONFIGURATION={"enabled":false,"cert_path":"","key_path":""}

# Development-only ATLAS workstation variables (never set/ship dev values in production)
ATLAS_ADMIN_TOKEN=
ATLAS_DATA_DIR=
ATLAS_KEYSTORE_PASSPHRASE=
ATLAS_SESSION_SECRET=